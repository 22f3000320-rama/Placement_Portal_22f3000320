<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monthly Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light p-4"> <div class="container-fluid max-w-100" style="max-width: 1200px;">
        
        <div class="card shadow-sm border-0 rounded-4">
            
            <div class="card-header bg-white border-bottom p-4">
                <h3 class="mb-0 text-primary fw-bold">Placement Drive Report</h3>
                <p class="text-muted mb-0 mt-1">Monthly summary of application statuses across all drives.</p>
            </div>
            
            <div class="card-body p-4">
                
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        
                        <thead class="table-light">
                            <tr>
                                <th class="py-3 text-center text-secondary" style="width: 80px;">Sr No.</th>
                                <th class="py-3 text-secondary">Company</th>
                                <th class="py-3 text-secondary">Job Title</th>
                                <th class="py-3 text-center text-secondary">Total Applied</th>
                                <th class="py-3 text-center text-secondary">Selected</th>
                                <th class="py-3 text-center text-secondary">Rejected</th>
                                <th class="py-3 text-center text-secondary">Pending</th>
                            </tr>
                        </thead>
                        
                        <tbody class="border-top-0">
                            
                            <tr>
                                <td class="py-3 text-center text-muted">1</td>
                                <td class="py-3 fw-bold text-dark">Flexmoney</td>
                                <td class="py-3">Data Science Intern</td>
                                
                                <td class="py-3 text-center">
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">1</span>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-success rounded-pill px-3 py-2">1</span>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-danger rounded-pill px-3 py-2">0</span>
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">0</span>
                                </td>
                            </tr>
                            
                        </tbody>
                        
                    </table>
                </div>
            </div>
        </div>
    </div>

</body>
